// Windows resources for the ApexShot executables: the app icon and the version
// block Explorer, the taskbar, and Add/Remove Programs read.
//
// The constants are numeric because rc.exe runs here without the Windows SDK
// headers on its include path: 0x40004 is VOS_NT_WINDOWS32, 0x1 is VFT_APP.
//
// The version pair arrives one of two ways, because rc takes a quoted value on
// its command line only when the shell handles the quoting: the Rust build
// passes both as macros, and CMake writes them into a header beside the
// compiled shell, since a quote cannot survive its way through to rc.exe.
#ifndef VERSION_STR
#include "apexshot-version.h"
#endif

1 ICON "apexshot.ico"

// The version block's resource ID must be 1: that is the entry Windows asks
// for, and a named "VS_VERSION_INFO" resource leaves Explorer's Details tab
// and Add/Remove Programs blank.
1 VERSIONINFO
 FILEVERSION VERSION
 PRODUCTVERSION VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ApexShot"
            VALUE "FileDescription", "ApexShot"
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "ApexShot"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "ApexShot.exe"
            VALUE "ProductName", "ApexShot"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
