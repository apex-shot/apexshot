[Desktop Entry]
Name=ApexShot
Comment=Open-source Linux screenshot, annotation, and screen recording tool
Exec=apexshot %u
Icon=org.apexshot.ApexShot
Type=Application
Categories=Graphics;Photography;
MimeType=x-scheme-handler/apexshot;
Keywords=screenshot;capture;recording;screen;video;linux;ocr;qr;annotation;
StartupNotify=true
StartupWMClass=org.apexshot.ApexShot
Terminal=false
X-GNOME-UsesNotifications=true
