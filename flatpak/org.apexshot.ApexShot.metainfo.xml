<component type="desktop-application">
  <id>org.apexshot.ApexShot</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>ApexShot</name>
  <summary>Capture and annotate your screen</summary>
  <developer id="org.apexshot">
    <name>codegoddy</name>
  </developer>
  <description>
    <p>ApexShot captures screenshots and screen recordings on Linux with Wayland portals and PipeWire support.</p>
    <p>Annotate captures, extract text with OCR, scan QR codes, and share results from one desktop application.</p>
    <p>This Flatpak build is portal-only: capture and recording use XDG desktop portals, telemetry is off by default, and host package tools are not used.</p>
  </description>
  <categories>
    <category>Graphics</category>
    <category>Photography</category>
  </categories>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/apex-shot/apexshot/v0.2.34/media/capture-area.png</image>
      <caption>Select a screen area to capture</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/apex-shot/apexshot/v0.2.34/media/video-recording.png</image>
