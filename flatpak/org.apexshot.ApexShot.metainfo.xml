    <screenshot>
      <image>https://raw.githubusercontent.com/apex-shot/apexshot/v0.2.34/media/video-editor.png</image>
      <caption>Edit a recorded video</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/apex-shot/apexshot/v0.2.34/media/setting-tray.png</image>
      <caption>Configure capture settings and tray actions</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://apexshot.org/</url>
